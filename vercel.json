{
  "version": 2,
  "builds": [
    {
      "src": "api/auth.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth(/.*)?",
      "dest": "/api/auth.js"
    },
    {
      "src": "/admin(/.*)?",
      "status": 200,
      "headers": { "Content-Type": "text/html" },
      "dest": "/public/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
